---
import Login from "./login.astro";
const {currentPageName} = Astro.props;
const pages:Map<string, string> = new Map<string, string>([
    ["/","Home"],
    ["/about","About"],
]);
---
<div id="nav-bar">
    <img src="/gitCloud/favicon.svg" style="margin: .8em;"/>
    <div style="display: flex; align-content: center;align-items: center; margin-right: .5rem;">GitCloud</div>
    <div class="redirects">
        {Array.from(pages, v => <a href={v[0]} class:list={currentPageName===v[1]? ["active"]:[]}> {v[1]} </a> )}
    </div>
    <Login/>
</div>

<style>
    #nav-bar{
        background: var(--background-3);
        margin-top: 1em;
        margin-bottom: 1em;
        justify-self: center;
            display: flex;
        flex-flow: row;
        justify-content: space-between;
        border-radius: 15px;
        min-width: 50svw;
        position: sticky;
        top: 1em;
        font-weight: bold;
        height: 5svh;
    }

    #nav-bar > div.redirects{
        display: flex;
        flex-flow: row;
        flex-grow: 1;
        justify-content: flex-start;
        align-items: center;
    }

    #nav-bar > div.redirects > a{
        display: flex;
        color: inherit;
        text-decoration: none;
        align-content: center;
        border-radius: 10px;
        padding: .4rem .4rem;
        margin: .5rem .5rem;
        min-width: 1.1rem;
        min-height: 1.1rem;
        box-sizing: border-box;
    }

    @keyframes redirectAnim {
        from{
            transform: rotate(0deg);
        }
        to{
            transform: rotate(360deg);
        }
    }

    #nav-bar > div.redirects > a:hover{
        background: var(--background-2);
        animation-name: redirectAnim;
        animation-delay: 10s;
        animation-duration: 1s;
        animation-timing-function: cubic-bezier(.75,0,.25,1);
        animation-iteration-count: 1;
    }
    #nav-bar > div.redirects > a.active{
        color: var(--accent-color);
        font-size: 1.1rem;
    }
</style>