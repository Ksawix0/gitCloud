---
const {currentPageName} = Astro.props;
const pages:Map<string, string> = new Map<string, string>([
    ["/","Home"],
    ["/about","About"],
]);
---
<div id="nav-bar">
    <div class="redirects">
        {Array.from(pages, v => <a href={v[0]} class:list={currentPageName===v[1]? ["active"]:[]}> {v[1]} </a> )}
    </div>
    <button id="loginButton">
        Login
    </button>
</div>

<style>
    #nav-bar{
        background: #2f2f33;
        margin-top: 1em;
        margin-bottom: 1em;
        justify-self: center;
        display: flex;
        flex-flow: row;
        justify-content: space-between;
        border-radius: 15px;
        min-width: 50svw;
        position: sticky;
        top: 1em;
        font-weight: bold;
    }

    #nav-bar > div.redirects{
        display: flex;
        flex-flow: row;
        flex-grow: 1;
        justify-content: flex-start;
    }

    #nav-bar > div.redirects > a{
        display: flex;
        color: inherit;
        text-decoration: none;
        align-content: center;
        border-radius: 10px;
        padding: .4rem .7rem;
        margin: .5rem .7rem;
        min-width: 1.1rem;
        min-height: 1.1rem;
        box-sizing: border-box;
    }

    @keyframes redirectAnim {
        from{
            transform: rotate(0deg);
        }
        to{
            transform: rotate(360deg);
        }
    }

    #nav-bar > div.redirects > a:hover{
        background: #252529;
        animation-name: redirectAnim;
        animation-delay: 10s;
        animation-duration: 1s;
        animation-timing-function: cubic-bezier(.75,0,.25,1);
        animation-iteration-count: 1;
    }
    #nav-bar > div.redirects > a.active{
        color: var(--accent-color);
        font-size: 1.1rem;
    }

    #loginButton{
        align-content: center;
        padding: .4rem .9rem;
        margin: .5rem .7rem;
        color: white;
        background: var(--accent-color);
        border-radius: 20px;
        font-weight: inherit;
        font-family: inherit;
        font-size: 1rem;
        border-style: none;

    }
    #loginButton:active{
        transform: translateY(.04rem);
        background: #e68550;
    }
</style>