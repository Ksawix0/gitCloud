---
const {pageName} = Astro.props;
import {Font} from "astro:assets";

import NavBar from "../components/nav-bar.astro"
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>GitCloud</title>

		<Font cssVariable="--font-oxanium"/>
	</head>
	<body>
		<NavBar currentPageName={pageName}/>

		<slot />
	</body>
</html>

<style is:global>

	body {
		margin: 0;
		width: 100%;
		height: 100%;
		color: white;
		background: #15151a;
		font-family: var(--font-oxanium),monospace;

		justify-items: center;
	}

	:root{
		--accent-color: #e67030;
		--light-background: #252529;
	}
</style>
