---
const {pageName} = Astro.props;
import {Font} from "astro:assets";

import NavBar from "../components/nav-bar.astro"
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=refresh,folder,upload_file" />
		<meta name="generator" content={Astro.generator} />
		<title>GitCloud</title>

		<Font cssVariable="--font-rubik"/>
	</head>
	<body>
		<NavBar currentPageName={pageName}/>

		<slot />
	</body>
</html>

<style is:global>

	body {
		margin: 0;
		width: 100%;
		height: 100%;
		color: white;
		background: #15151a;
		font-family: var(--font-rubik),monospace;

		justify-items: center;
	}

	:root{
		--default-font: var(--font-rubik);

		--accent-color: #e67030;
		--background-2: #252529;
		--background-3: #29292e;
		--element-color: #19191f;
	}

</style>